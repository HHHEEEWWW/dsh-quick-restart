{
  "name": "dsh-quick-restart",
  "version": "0.1.0",
  "description": "One-click restart for DSH, pinned to the Windows titlebar next to the native window controls.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "restart",
    "titlebar"
  ],
  "license": "MIT",
  "author": "HHHEEEWWW",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HHHEEEWWW/dsh-quick-restart.git"
  },
  "homepage": "https://github.com/HHHEEEWWW/dsh-quick-restart#readme",
  "bugs": {
    "url": "https://github.com/HHHEEEWWW/dsh-quick-restart/issues"
  }
}
